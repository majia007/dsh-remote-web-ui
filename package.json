{
  "name": "@jia-tools/dsh-remote-web-ui",
  "version": "1.0.1",
  "description": "Password-protected entry to the local DSH Web UI: an independent reverse proxy with its own login, no relay server or account system, usable behind any tunnel or port forwarder",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "remote",
    "web-ui",
    "local",
    "self-hosted",
    "proxy",
    "tunnel"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majia007/dsh-remote-web-ui.git"
  },
  "bugs": {
    "url": "https://github.com/majia007/dsh-remote-web-ui/issues"
  },
  "homepage": "https://github.com/majia007/dsh-remote-web-ui#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node build/build.mjs",
    "prepack": "node build/build.mjs",
    "prepare": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit \"tests/**/*.test.mjs\""
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "~0.22.2",
    "typescript": "^6.0.3"
  }
}
